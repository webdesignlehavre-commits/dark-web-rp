      "description": "Le marche noir RP. Produits garantis, livraison anonyme.",
      "html_content": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>DARK STORE</title>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&display=swap');\n\n* { margin: 0; padding: 0; box-sizing: border-box; }\n\nbody {\n  font-family: 'Fira Code', monospace;\n  background: #0a0a0f;\n  color: #00ff41;\n  min-height: 100vh;\n}\n\nbody::before {\n  content: '';\n  position: fixed;\n  top: 0; left: 0; width: 100%; height: 100%;\n  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,255,65,0.03) 2px, rgba(0,255,65,0.03) 4px);\n  pointer-events: none;\n  z-index: 9999;\n}\n\n.header {\n  background: #111118;\n  border-bottom: 1px solid #2a2a3a;\n  padding: 15px 30px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  position: sticky;\n  top: 0;\n  z-index: 100;\n  box-shadow: 0 0 30px rgba(0,255,65,0.1);\n}\n\n.logo {\n  font-size: 1.4em;\n  font-weight: 700;\n  color: #ff0040;\n  text-shadow: 0 0 20px rgba(255,0,64,0.5);\n  letter-spacing: 3px;\n}\n\n.logo span { color: #00ff41; text-shadow: 0 0 20px rgba(0,255,65,0.5); }\n\n.nav { display: flex; gap: 20px; align-items: center; }\n\n.nav a {\n  color: #008822;\n  text-decoration: none;\n  font-size: 0.8em;\n  padding: 8px 15px;\n  border: 1px solid #2a2a3a;\n  transition: all 0.3s;\n}\n\n.nav a:hover {\n  border-color: #00ff41;\n  color: #00ff41;\n  box-shadow: 0 0 15px rgba(0,255,65,0.2);\n}\n\n.cart-btn {\n  position: relative;\n  border-color: #ff0040 !important;\n  color: #ff0040 !important;\n}\n\n.cart-count {\n  position: absolute;\n  top: -5px; right: -5px;\n  background: #ff0040;\n  color: #000;\n  font-size: 0.65em;\n  padding: 2px 6px;\n  font-weight: 700;\n}\n\n.banner {\n  text-align: center;\n  padding: 40px 20px;\n  background: linear-gradient(180deg, #111118 0%, #0a0a0f 100%);\n  border-bottom: 1px solid #2a2a3a;\n}\n\n.banner h1 {\n  font-size: 2.5em;\n  color: #ff0040;\n  text-shadow: 0 0 30px rgba(255,0,64,0.4);\n  margin-bottom: 10px;\n  letter-spacing: 5px;\n}\n\n.banner .tagline {\n  color: #335544;\n  font-size: 0.9em;\n}\n\n.banner .warning {\n  color: #ffaa00;\n  font-size: 0.75em;\n  margin-top: 15px;\n  padding: 10px;\n  border: 1px solid #333;\n  display: inline-block;\n}\n\n.container { max-width: 1100px; margin: 0 auto; padding: 30px; }\n\n.categories {\n  display: flex;\n  gap: 10px;\n  margin-bottom: 30px;\n  flex-wrap: wrap;\n}\n\n.cat-btn {\n  padding: 8px 20px;\n  border: 1px solid #2a2a3a;\n  background: transparent;\n  color: #008822;\n  font-family: inherit;\n  font-size: 0.8em;\n  cursor: pointer;\n  transition: all 0.3s;\n}\n\n.cat-btn:hover, .cat-btn.active {\n  border-color: #00ff41;\n  color: #00ff41;\n  background: rgba(0,255,65,0.05);\n}\n\n.section-title {\n  color: #00ff41;\n  font-size: 1.2em;\n  margin: 30px 0 20px;\n  padding-bottom: 10px;\n  border-bottom: 1px solid #2a2a3a;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.section-title::before {\n  content: '>';\n  color: #ff0040;\n}\n\n.products-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));\n  gap: 20px;\n}\n\n.product-card {\n  background: #15151f;\n  border: 1px solid #2a2a3a;\n  padding: 20px;\n  transition: all 0.3s;\n  position: relative;\n  overflow: hidden;\n}\n\n.product-card::before {\n  content: '';\n  position: absolute;\n  top: 0; left: 0; width: 100%; height: 2px;\n  background: linear-gradient(90deg, transparent, #ff0040, transparent);\n  opacity: 0;\n  transition: opacity 0.3s;\n}\n\n.product-card:hover {\n  border-color: #ff0040;\n  box-shadow: 0 0 20px rgba(255,0,64,0.1);\n  transform: translateY(-3px);\n}\n\n.product-card:hover::before { opacity: 1; }\n\n.product-card .badge {\n  position: absolute;\n  top: 10px; right: 10px;\n  padding: 3px 8px;\n  font-size: 0.65em;\n  border: 1px solid #ffaa00;\n  color: #ffaa00;\n}\n\n.product-card .badge.hot {\n  border-color: #ff0040;\n  color: #ff0040;\n}\n\n.product-icon {\n  font-size: 2.5em;\n  text-align: center;\n  margin: 15px 0;\n}\n\n.product-name {\n  color: #00ff41;\n  font-size: 1em;\n  font-weight: 600;\n  margin-bottom: 8px;\n}\n\n.product-desc {\n  color: #335544;\n  font-size: 0.75em;\n  margin-bottom: 15px;\n  line-height: 1.5;\n}\n\n.product-footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.product-price {\n  color: #ffaa00;\n  font-size: 1.1em;\n  font-weight: 700;\n}\n\n.product-price .crypto {\n  font-size: 0.7em;\n  color: #555;\n  display: block;\n}\n\n.add-btn {\n  padding: 8px 15px;\n  border: 1px solid #00ff41;\n  background: transparent;\n  color: #00ff41;\n  font-family: inherit;\n  font-size: 0.75em;\n  cursor: pointer;\n  transition: all 0.3s;\n}\n\n.add-btn:hover {\n  background: #00ff41;\n  color: #0a0a0f;\n}\n\n.reviews {\n  margin-top: 15px;\n  padding-top: 10px;\n  border-top: 1px solid #1a1a25;\n}\n\n.review {\n  font-size: 0.7em;\n  color: #335544;\n  margin: 5px 0;\n}\n\n.review .stars { color: #ffaa00; }\n.review .user { color: #008822; }\n\n.seller-info {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-top: 10px;\n  padding: 8px;\n  background: #111118;\n  font-size: 0.7em;\n}\n\n.seller-info .online {\n  width: 6px; height: 6px;\n  background: #00ff41;\n  border-radius: 50%;\n  animation: pulse 2s infinite;\n}\n\n@keyframes pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.3; }\n}\n\n.cart-panel {\n  display: none;\n  position: fixed;\n  top: 0; right: 0;\n  width: 350px;\n  height: 100%;\n  background: #111118;\n  border-left: 1px solid #2a2a3a;\n  z-index: 200;\n  padding: 20px;\n  overflow-y: auto;\n  box-shadow: -5px 0 30px rgba(0,0,0,0.5);\n}\n\n.cart-panel.open { display: block; }\n\n.cart-panel h3 {\n  color: #ff0040;\n  margin-bottom: 20px;\n  padding-bottom: 10px;\n  border-bottom: 1px solid #2a2a3a;\n}\n\n.cart-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 10px;\n  border: 1px solid #2a2a3a;\n  margin-bottom: 10px;\n}\n\n.cart-item .remove {\n  color: #ff0040;\n  cursor: pointer;\n  font-size: 0.8em;\n}\n\n.cart-total {\n  margin-top: 20px;\n  padding-top: 15px;\n  border-top: 1px solid #2a2a3a;\n  text-align: right;\n}\n\n.cart-total .amount {\n  color: #ffaa00;\n  font-size: 1.3em;\n  font-weight: 700;\n}\n\n.checkout-btn {\n  width: 100%;\n  padding: 12px;\n  margin-top: 15px;\n  border: 1px solid #ff0040;\n  background: transparent;\n  color: #ff0040;\n  font-family: inherit;\n  font-size: 0.9em;\n  cursor: pointer;\n  transition: all 0.3s;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n}\n\n.checkout-btn:hover {\n  background: #ff0040;\n  color: #000;\n}\n\n.overlay {\n  display: none;\n  position: fixed;\n  top: 0; left: 0;\n  width: 100%; height: 100%;\n  background: rgba(0,0,0,0.7);\n  z-index: 199;\n}\n\n.overlay.open { display: block; }\n\n.status-bar {\n  background: #111118;\n  border-top: 1px solid #2a2a3a;\n  padding: 10px 30px;\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.7em;\n  color: #335544;\n  position: fixed;\n  bottom: 0;\n  width: 100%;\n  z-index: 50;\n}\n\n.status-bar .online { color: #00ff41; }\n.status-bar .threat { color: #ffaa00; }\n\n.footer {\n  text-align: center;\n  padding: 40px;\n  color: #222;\n  font-size: 0.7em;\n  margin-top: 40px;\n  border-top: 1px solid #1a1a25;\n}\n\n.toast {\n  position: fixed;\n  bottom: 60px;\n  right: 20px;\n  background: #15151f;\n  border: 1px solid #00ff41;\n  padding: 15px 20px;\n  color: #00ff41;\n  font-family: inherit;\n  font-size: 0.8em;\n  z-index: 300;\n  transform: translateX(400px);\n  transition: transform 0.3s;\n  box-shadow: 0 0 20px rgba(0,255,65,0.2);\n}\n\n.toast.show { transform: translateX(0); }\n\n@media (max-width: 768px) {\n  .banner h1 { font-size: 1.5em; }\n  .products-grid { grid-template-columns: 1fr; }\n  .cart-panel { width: 100%; }\n}\n</style>\n</head>\n<body>\n\n<div class=\"header\">\n  <div class=\"logo\">DARK<span>STORE</span></div>\n  <div class=\"nav\">\n    <a href=\"#\">COMMANDES</a>\n    <a href=\"#\">VANDBEUR</a>\n    <a href=\"#\" class=\"cart-btn\" onclick=\"toggleCart()\">PANIER <span class=\"cart-count\" id=\"cart-count\">0</span></a>\n  </div>\n</div>\n\n<div class=\"banner\">\n  <h1>&#128274; DARK STORE</h1>\n  <div class=\"tagline\">Le marche noir RP. Produits garantis, livraison anonyme.</div>\n  <div class=\"warning\">&#9888; USAGE RP UNIQUEMENT. PAS DE VRAIS achats.</div>\n</div>\n\n<div class=\"container\">\n  <div class=\"categories\">\n    <button class=\"cat-btn active\" onclick=\"filterCat('all', this)\">TOUS</button>\n    <button class=\"cat-btn\" onclick=\"filterCat('hacking', this)\">HACKING</button>\n    <button class=\"cat-btn\" onclick=\"filterCat('weapons', this)\">ARMES</button>\n    <button class=\"cat-btn\" onclick=\"filterCat('drugs', this)\">DROGUES</button>\n    <button class=\"cat-btn\" onclick=\"filterCat('tools', this)\">OUTILS</button>\n    <button class=\"cat-btn\" onclick=\"filterCat('docs', this)\">FAUX DOCUMENTS</button>\n  </div>\n\n  <div class=\"section-title\">CATALOGUE</div>\n  <div class=\"products-grid\" id=\"products\"></div>\n\n  <div class=\"section-title\">VENTES RECENTES</div>\n  <div style=\"padding:15px;border:1px solid #2a2a3a;font-size:0.8em;color:#335544\">\n    <div style=\"margin-bottom:10px\">[<span style=\"color:#008822\">xH4cker_92</span>] a achete <span style=\"color:#00ff41\">USB Keylogger</span> — il y a 12 min</div>\n    <div style=\"margin-bottom:10px\">[<span style=\"color:#008822\">DarkLord_FR</span>] a achete <span style=\"color:#00ff41\">Passeport Faux</span> — il y a 34 min</div>\n    <div style=\"margin-bottom:10px\">[<span style=\"color:#008822\">Shadow_X</span>] a achete <span style=\"color:#00ff41\">AK-47 Suppressée</span> — il y a 1h</div>\n    <div style=\"margin-bottom:10px\">[<span style=\"color:#008822\">NoFace</span>] a achete <span style=\"color:#00ff41\">Malware Pack v3</span> — il y a 2h</div>\n    <div>[<span style=\"color:#008822\">Ghost_007</span>] a achete <span style=\"color:#00ff41\">Silencieux Mod.45</span> — il y a 3h</div>\n  </div>\n</div>\n\n<div class=\"cart-panel\" id=\"cart-panel\">\n  <h3>&#128722; PANIER</h3>\n  <div id=\"cart-items\"></div>\n  <div class=\"cart-total\">\n    <div style=\"color:#555;font-size:0.8em;margin-bottom:5px\">TOTAL</div>\n    <div class=\"amount\" id=\"cart-total\">0 &#8383;</div>\n  </div>\n  <button class=\"checkout-btn\" onclick=\"checkout()\">PASSER COMMANDE</button>\n  <p style=\"text-align:center;margin-top:15px;font-size:0.7em;color:#333\">Paiement: Bitcoin / Monero</p>\n</div>\n<div class=\"overlay\" id=\"overlay\" onclick=\"toggleCart()\"></div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<div class=\"status-bar\">\n  <div><span class=\"online\">&#9679;</span> EN LIGNE</div>\n  <div>Vendeur: <span style=\"color:#00ff41\">D4rkSh0p_Admin</span></div>\n  <div>Menace: <span class=\"threat\">FAIBLE</span></div>\n  <div>TOR: Connecte</div>\n</div>\n\n<div class=\"footer\">\n  DARK STORE RP &copy; 2026 // TOUT EST FICTIF // ROLEPLAY UNIQUEMENT\n</div>\n\n<script>\nconst products = [\n  { id: 1, name: \"USB Keylogger\", desc: \"Enregistre toutes les frappes clavier. USB discrete. Range: 10m via WiFi.\", price: 2500, crypto: \"0.00042 BTC\", icon: \"&#128268;\", cat: \"hacking\", badge: \"HOT\", badgeClass: \"hot\", seller: \"TechDealer\", reviews: 14, stars: 4.8 },\n  { id: 2, name: \"Malware Pack v3\", desc: \"12 malware differs. Ransomware, trojan, keylogger. Support 30 jours.\", price: 8000, crypto: \"0.00134 BTC\", icon: \"&#128187;\", cat: \"hacking\", badge: \"NEW\", badgeClass: \"\", seller: \"VirusMaster\", reviews: 7, stars: 4.5 },\n  { id: 3, name: \"AK-47 Supprimee\", desc: \"AK-47 avec silencieux custom. Munitions 7.62 incluses (30 balles).\", price: 15000, crypto: \"0.00251 BTC\", icon: \"&#128299;\", cat: \"weapons\", badge: \"\", badgeClass: \"\", seller: \"Armurier_76\", reviews: 22, stars: 4.9 },\n  { id: 4, name: \"Silencieux Mod.45\", desc: \"Silencieux universel calibre .45. Compatible Glock, USP, 1911.\", price: 5000, crypto: \"0.00083 BTC\", icon: \"&#128296;\", cat: \"weapons\", badge: \"\", badgeClass: \"\", seller: \"Armurier_76\", reviews: 9, stars: 4.7 },\n  { id: 5, name: \"Cannabis Premium\", desc: \"50g de Green Dragon. THC: 28%. Cultive en indoor.\", price: 3000, crypto: \"0.00050 BTC\", icon: \"&#127807;\", cat: \"drugs\", badge: \"PREMIUM\", badgeClass: \"\", seller: \"GrowMaster\", reviews: 31, stars: 4.6 },\n  { id: 6, name: \"Methamphetamine Crystal\", desc: \"20g pur. Qualite Breaking Bad. Livraison sechee.\", price: 7500, crypto: \"0.00125 BTC\", icon: \"&#10024;\", cat: \"drugs\", badge: \"\", badgeClass: \"\", seller: \"Chemist_X\", reviews: 5, stars: 4.2 },\n  { id: 7, name: \"Passeport Faux\", desc: \"Passeport francais tres haute qualite. Photo personnalisee.\", price: 12000, crypto: \"0.00200 BTC\", icon: \"&#128220;\", cat: \"docs\", badge: \"TOP\", badgeClass: \"hot\", seller: \"DocMaker\", reviews: 18, stars: 4.9 },\n  { id: 8, name: \"Permis de conduire\", desc: \"Permis francais avec code barre. Verifiable en ligne.\", price: 4000, crypto: \"0.00067 BTC\", icon: \"&#128663;\", cat: \"docs\", badge: \"\", badgeClass: \"\", seller: \"DocMaker\", reviews: 12, stars: 4.4 },\n  { id: 9, name: \"Lockpick Set Pro\", desc: \"Kit complet 32 outils. Pochette discrete. Tutoriel inclus.\", price: 800, crypto: \"0.00013 BTC\", icon: \"&#128274;\", cat: \"tools\", badge: \"\", badgeClass: \"\", seller: \"LockBreaker\", reviews: 25, stars: 4.8 },\n  { id: 10, name: \"GPS Tracker Mini\", desc: \"Tracker GPS 5cm. Batterie 7 jours. Suivi en temps reel.\", price: 3500, crypto: \"0.00058 BTC\", icon: \"&#128205;\", cat: \"tools\", badge: \"NEW\", badgeClass: \"\", seller: \"SpyGadgets\", reviews: 8, stars: 4.3 },\n  { id: 11, name: \"Flash Drive 256GB\", desc: \"Clé USB chiffrée AES-256. Formatage a distance possible.\", price: 1200, crypto: \"0.00020 BTC\", icon: \"&#128190;\", cat: \"hacking\", badge: \"\", badgeClass: \"\", seller: \"TechDealer\", reviews: 16, stars: 4.7 },\n  { id: 12, name: \"Glock 19 + Munitions\", desc: \"Glock 19 Gen5. 3 chargeurs (45 balles). Etui de ceinture.\", price: 9000, crypto: \"0.00150 BTC\", icon: \"&#128298;\", cat: \"weapons\", badge: \"\", badgeClass: \"\", seller: \"Armurier_76\", reviews: 19, stars: 4.8 }\n];\n\nlet cart = [];\n\nfunction renderProducts(filter = 'all') {\n  const grid = document.getElementById('products');\n  const filtered = filter === 'all' ? products : products.filter(p => p.cat === filter);\n  \n  grid.innerHTML = filtered.map(p => `\n    <div class=\"product-card\" data-cat=\"${p.cat}\">\n      ${p.badge ? `<div class=\"badge ${p.badgeClass}\">${p.badge}</div>` : ''}\n      <div class=\"product-icon\">${p.icon}</div>\n      <div class=\"product-name\">${p.name}</div>\n      <div class=\"product-desc\">${p.desc}</div>\n      <div class=\"reviews\">\n        <span class=\"stars\">${'&#9733;'.repeat(Math.floor(p.stars))}${'&#9734;'.repeat(5-Math.floor(p.stars))}</span>\n        <span style=\"color:#555\">(${p.reviews} avis)</span>\n      </div>\n      <div class=\"seller-info\">\n        <span class=\"online\"></span>\n        <span style=\"color:#008822\">${p.seller}</span>\n        <span style=\"margin-left:auto;color:#333\">Verifie</span>\n      </div>\n      <div class=\"product-footer\">\n        <div class=\"product-price\">${p.price.toLocaleString()} &#8383;<span class=\"crypto\">${p.crypto}</span></div>\n        <button class=\"add-btn\" onclick=\"addToCart(${p.id})\">+ AJOUTER</button>\n      </div>\n    </div>\n  `).join('');\n}\n\nfunction filterCat(cat, btn) {\n  document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));\n  btn.classList.add('active');\n  renderProducts(cat);\n}\n\nfunction addToCart(id) {\n  const product = products.find(p => p.id === id);\n  cart.push(product);\n  updateCart();\n  showToast(`${product.name} ajoute au panier`);\n}\n\nfunction removeFromCart(index) {\n  cart.splice(index, 1);\n  updateCart();\n}\n\nfunction updateCart() {\n  document.getElementById('cart-count').textContent = cart.length;\n  const items = document.getElementById('cart-items');\n  const total = cart.reduce((sum, p) => sum + p.price, 0);\n  \n  items.innerHTML = cart.length === 0 \n    ? '<p style=\"color:#333;text-align:center;padding:30px\">Panier vide</p>'\n    : cart.map((p, i) => `\n        <div class=\"cart-item\">\n          <div>\n            <div style=\"color:#00ff41;font-size:0.85em\">${p.icon} ${p.name}</div>\n            <div style=\"color:#ffaa00;font-size:0.75em\">${p.price.toLocaleString()} &#8383;</div>\n          </div>\n          <span class=\"remove\" onclick=\"removeFromCart(${i})\">&#10006;</span>\n        </div>\n      `).join('');\n  \n  document.getElementById('cart-total').textContent = total.toLocaleString() + ' &#8383;';\n}\n\nfunction toggleCart() {\n  document.getElementById('cart-panel').classList.toggle('open');\n  document.getElementById('overlay').classList.toggle('open');\n}\n\nfunction checkout() {\n  if (cart.length === 0) return showToast('Panier vide !');\n  const total = cart.reduce((sum, p) => sum + p.price, 0);\n  showToast(`Commande passee ! Total: ${total.toLocaleString()} BTC`);\n  cart = [];\n  updateCart();\n  toggleCart();\n}\n\nfunction showToast(msg) {\n  const toast = document.getElementById('toast');\n  toast.textContent = msg;\n  toast.classList.add('show');\n  setTimeout(() => toast.classList.remove('show'), 3000);\n}\n\nrenderProducts();\nupdateCart();\n</script>\n</body>\n</html>\n",
